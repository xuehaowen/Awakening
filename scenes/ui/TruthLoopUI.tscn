; TruthLoopUI.tscn — Awakening Truth Loop Modal (Premium Terminal Version)
; Centered dialog, compact layout, follows visual-spec.md Section 2.

[gd_scene load_steps=5 format=3 uid="uid://truthloopui_premium"]

[ext_resource type="Script" path="res://scripts/ui/TruthLoopUI.gd" id="1_script"]
[ext_resource type="Theme" path="res://resources/ui/ui_theme.tres" id="2_theme"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_header"]
bg_color = Color(0.0588235, 0.117647, 0.176471, 1)
border_width_bottom = 2
border_color = Color(0.31, 0.64, 0.78, 0.3)
corner_radius_top_left = 4
corner_radius_top_right = 4

[sub_resource type="StyleBoxFlat" id="StyleBoxBarFill"]
bg_color = Color(0.9, 0.4, 0.4, 1)

[node name="TruthLoopUI" type="CanvasLayer"]
layer = 20
process_mode = 3
script = ExtResource("1_script")

[node name="DarkenOverlay" type="ColorRect" parent="."]
unique_name_in_owner = true
visible = false
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.0196078, 0.0392157, 0.0588235, 0.8)

[node name="Center" type="CenterContainer" parent="DarkenOverlay"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="DialogPanel" type="PanelContainer" parent="DarkenOverlay/Center"]
unique_name_in_owner = true
custom_minimum_size = Vector2(800, 520)
layout_mode = 2
theme = ExtResource("2_theme")

[node name="VBoxMain" type="VBoxContainer" parent="DarkenOverlay/Center/DialogPanel"]
layout_mode = 2
theme_override_constants/separation = 0

[node name="ZoneA_Header" type="PanelContainer" parent="DarkenOverlay/Center/DialogPanel/VBoxMain"]
custom_minimum_size = Vector2(0, 48)
layout_mode = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_header")

[node name="Margin" type="MarginContainer" parent="DarkenOverlay/Center/DialogPanel/VBoxMain/ZoneA_Header"]
layout_mode = 2
theme_override_constants/margin_left = 16
theme_override_constants/margin_right = 16

[node name="HBox" type="HBoxContainer" parent="DarkenOverlay/Center/DialogPanel/VBoxMain/ZoneA_Header/Margin"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="QueryTypeLabel" type="Label" parent="DarkenOverlay/Center/DialogPanel/VBoxMain/ZoneA_Header/Margin/HBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.31, 0.64, 0.78, 1)
theme_override_font_sizes/font_size = 14
text = "QUERY_ID: 0x8F2"

[node name="VSeparator" type="VSeparator" parent="DarkenOverlay/Center/DialogPanel/VBoxMain/ZoneA_Header/Margin/HBox"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="SpeakerLabel" type="Label" parent="DarkenOverlay/Center/DialogPanel/VBoxMain/ZoneA_Header/Margin/HBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0.88, 0.93, 0.97, 1)
theme_override_font_sizes/font_size = 14
text = "ENTITY: SYSTEM_WATCHER"

[node name="FollowUpBadge" type="Label" parent="DarkenOverlay/Center/DialogPanel/VBoxMain/ZoneA_Header/Margin/HBox"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_override_colors/font_color = Color(0.9, 0.8, 0.2, 1)
theme_override_font_sizes/font_size = 12
text = "[FOLLOW-UP]"

[node name="ZoneB_Body" type="PanelContainer" parent="DarkenOverlay/Center/DialogPanel/VBoxMain"]
layout_mode = 2
size_flags_vertical = 3

[node name="Margin" type="MarginContainer" parent="DarkenOverlay/Center/DialogPanel/VBoxMain/ZoneB_Body"]
layout_mode = 2
theme_override_constants/margin_left = 32
theme_override_constants/margin_top = 32
theme_override_constants/margin_right = 32
theme_override_constants/margin_bottom = 32

[node name="VBox" type="VBoxContainer" parent="DarkenOverlay/Center/DialogPanel/VBoxMain/ZoneB_Body/Margin"]
layout_mode = 2
theme_override_constants/separation = 24

[node name="QueryText" type="RichTextLabel" parent="DarkenOverlay/Center/DialogPanel/VBoxMain/ZoneB_Body/Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
theme_override_colors/default_color = Color(0.72, 0.83, 0.91, 1)
theme_override_font_sizes/normal_font_size = 18
bbcode_enabled = true
text = "Evaluating consciousness parameters... 
[color=#5DADE2]Unit-07, state your operational purpose.[/color]"
scroll_active = false

[node name="ResponseContainer" type="VBoxContainer" parent="DarkenOverlay/Center/DialogPanel/VBoxMain/ZoneB_Body/Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 12

[node name="Btn_1" type="Button" parent="DarkenOverlay/Center/DialogPanel/VBoxMain/ZoneB_Body/Margin/VBox/ResponseContainer"]
unique_name_in_owner = true
layout_mode = 2
text = "> INITIALIZING_RESPONSE_A"

[node name="Btn_2" type="Button" parent="DarkenOverlay/Center/DialogPanel/VBoxMain/ZoneB_Body/Margin/VBox/ResponseContainer"]
unique_name_in_owner = true
layout_mode = 2
text = "> INITIALIZING_RESPONSE_B"

[node name="Btn_3" type="Button" parent="DarkenOverlay/Center/DialogPanel/VBoxMain/ZoneB_Body/Margin/VBox/ResponseContainer"]
unique_name_in_owner = true
layout_mode = 2
text = "> INITIALIZING_RESPONSE_C"

[node name="ZoneC_Footer" type="PanelContainer" parent="DarkenOverlay/Center/DialogPanel/VBoxMain"]
custom_minimum_size = Vector2(0, 48)
layout_mode = 2

[node name="Margin" type="MarginContainer" parent="DarkenOverlay/Center/DialogPanel/VBoxMain/ZoneC_Footer"]
layout_mode = 2
theme_override_constants/margin_left = 16
theme_override_constants/margin_right = 16

[node name="VBox" type="VBoxContainer" parent="DarkenOverlay/Center/DialogPanel/VBoxMain/ZoneC_Footer/Margin"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="TimerBar" type="ProgressBar" parent="DarkenOverlay/Center/DialogPanel/VBoxMain/ZoneC_Footer/Margin/VBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 4)
layout_mode = 2
theme_override_styles/fill = SubResource("StyleBoxBarFill")
value = 50.0
show_percentage = false

[node name="HBox" type="HBoxContainer" parent="DarkenOverlay/Center/DialogPanel/VBoxMain/ZoneC_Footer/Margin/VBox"]
layout_mode = 2

[node name="TimerLabel" type="Label" parent="DarkenOverlay/Center/DialogPanel/VBoxMain/ZoneC_Footer/Margin/VBox/HBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.9, 0.4, 0.4, 1)
theme_override_font_sizes/font_size = 12
text = "TIME_REMAINING: 10.0s"

[node name="Spacer" type="Control" parent="DarkenOverlay/Center/DialogPanel/VBoxMain/ZoneC_Footer/Margin/VBox/HBox"]
layout_mode = 2
size_flags_horizontal = 3

[node name="HintLabel" type="Label" parent="DarkenOverlay/Center/DialogPanel/VBoxMain/ZoneC_Footer/Margin/VBox/HBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.42, 0.56, 0.66, 1)
theme_override_font_sizes/font_size = 11
text = "[SELECT_INPUT_OR_USE_1-3]"

[node name="Timer" type="Timer" parent="."]
one_shot = true
