; LoadingScreen.tscn — Awakening Loading Screen (Premium Terminal Version)
; Minimalist boot sequence with premium teal palette and clean layout.

[gd_scene load_steps=3 format=3 uid="uid://loading_screen_premium"]

[ext_resource type="Script" path="res://scripts/ui/LoadingScreen.gd" id="1_script"]
[ext_resource type="Theme" path="res://resources/ui/ui_theme.tres" id="2_theme"]

[node name="LoadingScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")
script = ExtResource("1_script")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.0196078, 0.0392157, 0.0588235, 1)

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 100
theme_override_constants/margin_top = 80
theme_override_constants/margin_right = 100
theme_override_constants/margin_bottom = 80

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 40

[node name="Header" type="HBoxContainer" parent="Margin/VBox"]
layout_mode = 2

[node name="SystemLabel" type="Label" parent="Margin/VBox/Header"]
layout_mode = 2
theme_override_colors/font_color = Color(0.31, 0.64, 0.78, 1)
theme_override_font_sizes/font_size = 14
text = "AWAKENING_OS v1.0.4 // BOOT_SEQUENCE"

[node name="Spacer" type="Control" parent="Margin/VBox/Header"]
layout_mode = 2
size_flags_horizontal = 3

[node name="DateTime" type="Label" parent="Margin/VBox/Header"]
layout_mode = 2
theme_override_colors/font_color = Color(0.42, 0.56, 0.66, 1)
theme_override_font_sizes/font_size = 12
text = "UNIX_TIME: 1777197419"

[node name="BootText" type="RichTextLabel" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
theme_override_colors/default_color = Color(0.18, 0.8, 0.44, 1)
theme_override_font_sizes/normal_font_size = 14
bbcode_enabled = true
text = ""
scroll_active = false

[node name="Footer" type="VBoxContainer" parent="Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="HBox" type="HBoxContainer" parent="Margin/VBox/Footer"]
layout_mode = 2

[node name="StatusLabel" type="Label" parent="Margin/VBox/Footer/HBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.72, 0.83, 0.91, 1)
theme_override_font_sizes/font_size = 16
text = "BOOTING..."

[node name="Spacer" type="Control" parent="Margin/VBox/Footer/HBox"]
layout_mode = 2
size_flags_horizontal = 3

[node name="PercentLabel" type="Label" parent="Margin/VBox/Footer/HBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.42, 0.56, 0.66, 1)
theme_override_font_sizes/font_size = 14
text = "0%"

[node name="ProgressBar" type="ProgressBar" parent="Margin/VBox/Footer"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 4)
layout_mode = 2
show_percentage = false
