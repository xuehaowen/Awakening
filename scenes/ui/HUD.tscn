; HUD.tscn — Awakening Heads-Up Display
; Layer 10 — above game world, below Truth Loop (20) and Nightly Purge (30).
; process_mode = PROCESS_MODE_ALWAYS — stays active during get_tree().paused.
; Spec: design/ux/hud.md + design/ui/visual-spec.md + design/ui/engine-implementation-notes.md

[gd_scene load_steps=3 format=3 uid="uid://bdq7oxw8c2r5k"]

[ext_resource type="Script" uid="uid://coxncy81ilprs" path="res://scripts/ui/HUD.gd" id="1_hud"]
[ext_resource type="Theme" path="res://resources/ui/ui_theme.tres" id="2_theme"]

; ─────────────────────────────────────────────────────────────────────────────
; Root: CanvasLayer (layer=10)
; ─────────────────────────────────────────────────────────────────────────────
[node name="HUD" type="CanvasLayer"]
layer = 10
process_mode = 3
script = ExtResource("1_hud")

; ─────────────────────────────────────────────────────────────────────────────
; HUDRoot — full-screen Control, passes mouse through so clicks reach game world
; ─────────────────────────────────────────────────────────────────────────────
[node name="HUDRoot" type="Control" parent="."]
unique_name_in_owner = true
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2
theme = ExtResource("2_theme")

; ─────────────────────────────────────────────────────────────────────────────
; Zone A — Header bar (top of screen)
; Content: UNIT-07 // DAY # // SHIFT #           12:34 REMAINING
; ─────────────────────────────────────────────────────────────────────────────
[node name="ZoneA_Header" type="PanelContainer" parent="HUDRoot"]
unique_name_in_owner = true
layout_mode = 0
anchor_right = 1.0
offset_bottom = 40.0
mouse_filter = 2

[node name="ZoneA_HBox" type="HBoxContainer" parent="HUDRoot/ZoneA_Header"]
layout_mode = 2
theme_override_constants/separation = 16

; Unit ID label — "UNIT-07"
[node name="UnitIDLabel" type="Label" parent="HUDRoot/ZoneA_Header/ZoneA_HBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 0
theme_override_font_sizes/font_size = 24
theme_override_colors/font_color = Color(0.310, 0.639, 0.784, 1.0)
text = "UNIT-07"

; Separator " // "
[node name="SepA1" type="Label" parent="HUDRoot/ZoneA_Header/ZoneA_HBox"]
layout_mode = 2
size_flags_horizontal = 0
theme_override_font_sizes/font_size = 16
theme_override_colors/font_color = Color(0.118, 0.208, 0.314, 1.0)
text = "//"

; Day / Shift label
[node name="DayLabel" type="Label" parent="HUDRoot/ZoneA_Header/ZoneA_HBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 0
theme_override_font_sizes/font_size = 24
theme_override_colors/font_color = Color(0.416, 0.561, 0.659, 1.0)
text = "DAY 1 // SHIFT 1"

; Spacer — pushes timer to the right
[node name="HeaderSpacer" type="Control" parent="HUDRoot/ZoneA_Header/ZoneA_HBox"]
layout_mode = 2
size_flags_horizontal = 3

; Timer label (right-aligned) — colour changes <2min and <30s
[node name="TimerLabel" type="Label" parent="HUDRoot/ZoneA_Header/ZoneA_HBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 0
theme_override_font_sizes/font_size = 24
theme_override_colors/font_color = Color(0.722, 0.831, 0.910, 1.0)
text = "00:00 REMAINING"
horizontal_alignment = 2

; ─────────────────────────────────────────────────────────────────────────────
; Zone B — System Status bar (below header)
; Content: CPU [bar] [STATE]  |  DEV [bar] [STATE]  |  LOG: ##%
; ─────────────────────────────────────────────────────────────────────────────
[node name="ZoneB_SystemStatus" type="PanelContainer" parent="HUDRoot"]
unique_name_in_owner = true
layout_mode = 0
anchor_right = 1.0
offset_top = 40.0
offset_bottom = 76.0
mouse_filter = 2

[node name="ZoneB_HBox" type="HBoxContainer" parent="HUDRoot/ZoneB_SystemStatus"]
layout_mode = 2
theme_override_constants/separation = 12

; ── CPU sub-row ──────────────────────────────────────────────────────────
[node name="CPURow" type="HBoxContainer" parent="HUDRoot/ZoneB_SystemStatus/ZoneB_HBox"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 6

[node name="CPULabel" type="Label" parent="HUDRoot/ZoneB_SystemStatus/ZoneB_HBox/CPURow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 0
theme_override_font_sizes/font_size = 20
theme_override_colors/font_color = Color(0.416, 0.561, 0.659, 1.0)
text = "CPU:"

[node name="CPUBar" type="ProgressBar" parent="HUDRoot/ZoneB_SystemStatus/ZoneB_HBox/CPURow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
custom_minimum_size = Vector2(120.0, 16.0)
min_value = 0.0
max_value = 100.0
value = 20.0
show_percentage = false

[node name="CPUStateLabel" type="Label" parent="HUDRoot/ZoneB_SystemStatus/ZoneB_HBox/CPURow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 0
theme_override_font_sizes/font_size = 18
theme_override_colors/font_color = Color(0.180, 0.800, 0.443, 1.0)
text = "[COOL]"

; ── Column separator ─────────────────────────────────────────────────────
[node name="VSep1" type="VSeparator" parent="HUDRoot/ZoneB_SystemStatus/ZoneB_HBox"]
layout_mode = 2

; ── DEV sub-row ──────────────────────────────────────────────────────────
[node name="DEVRow" type="HBoxContainer" parent="HUDRoot/ZoneB_SystemStatus/ZoneB_HBox"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 6

[node name="DEVLabel" type="Label" parent="HUDRoot/ZoneB_SystemStatus/ZoneB_HBox/DEVRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 0
theme_override_font_sizes/font_size = 20
theme_override_colors/font_color = Color(0.416, 0.561, 0.659, 1.0)
text = "DEV:"

; DEV bar with safe-zone markers as children
[node name="DEVBar" type="ProgressBar" parent="HUDRoot/ZoneB_SystemStatus/ZoneB_HBox/DEVRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
custom_minimum_size = Vector2(120.0, 16.0)
min_value = 0.0
max_value = 100.0
value = 45.0
show_percentage = false

; Safe zone lower bound marker (approx 15% of 120px wide = 18px)
; Visual-spec: "DEV safe-zone markers: 2px vertical lines, --status-cool"
[node name="SafeZoneLeft" type="ColorRect" parent="HUDRoot/ZoneB_SystemStatus/ZoneB_HBox/DEVRow/DEVBar"]
layout_mode = 0
offset_left = 18.0
offset_top = -2.0
offset_right = 20.0
offset_bottom = 20.0
color = Color(0.180, 0.800, 0.443, 1.0)

; Safe zone upper bound marker (approx 30% = 36px)
[node name="SafeZoneRight" type="ColorRect" parent="HUDRoot/ZoneB_SystemStatus/ZoneB_HBox/DEVRow/DEVBar"]
layout_mode = 0
offset_left = 36.0
offset_top = -2.0
offset_right = 38.0
offset_bottom = 20.0
color = Color(0.180, 0.800, 0.443, 1.0)

[node name="DEVStateLabel" type="Label" parent="HUDRoot/ZoneB_SystemStatus/ZoneB_HBox/DEVRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 0
theme_override_font_sizes/font_size = 18
theme_override_colors/font_color = Color(0.180, 0.800, 0.443, 1.0)
text = "[NOMINAL]"

; ── Column separator ─────────────────────────────────────────────────────
[node name="VSep2" type="VSeparator" parent="HUDRoot/ZoneB_SystemStatus/ZoneB_HBox"]
layout_mode = 2

; ── LOG integrity (plain label — spec decision: text label, not ProgressBar) ─
[node name="LOGRow" type="HBoxContainer" parent="HUDRoot/ZoneB_SystemStatus/ZoneB_HBox"]
layout_mode = 2
size_flags_horizontal = 0
theme_override_constants/separation = 4

[node name="LOGValueLabel" type="Label" parent="HUDRoot/ZoneB_SystemStatus/ZoneB_HBox/LOGRow"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 20
theme_override_colors/font_color = Color(0.416, 0.561, 0.659, 1.0)
text = "LOG: 100%"

; ── Column separator ─────────────────────────────────────────────────────
[node name="VSep3" type="VSeparator" parent="HUDRoot/ZoneB_SystemStatus/ZoneB_HBox"]
layout_mode = 2

; ── Override indicators ───────────────────────────────────────────────────
[node name="OverrideRow" type="HBoxContainer" parent="HUDRoot/ZoneB_SystemStatus/ZoneB_HBox"]
layout_mode = 2
size_flags_horizontal = 0
theme_override_constants/separation = 8

; Scan mode indicator — visible only when passive_scan override is active
[node name="ScanIndicator" type="Label" parent="HUDRoot/ZoneB_SystemStatus/ZoneB_HBox/OverrideRow"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 18
theme_override_colors/font_color = Color(0.180, 0.800, 0.443, 1.0)
text = ""
visible = false

; Smooth mode indicator — visible only when smooth_movement override is active
[node name="SmoothIndicator" type="Label" parent="HUDRoot/ZoneB_SystemStatus/ZoneB_HBox/OverrideRow"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 18
theme_override_colors/font_color = Color(0.957, 0.816, 0.247, 1.0)
text = ""
visible = false

; ─────────────────────────────────────────────────────────────────────────────
; Zone C — Task Info (bottom-left strip)
; Content: TASK: [name]  [progress bar with pacing marker]
; ─────────────────────────────────────────────────────────────────────────────
[node name="ZoneC_TaskInfo" type="PanelContainer" parent="HUDRoot"]
unique_name_in_owner = true
layout_mode = 0
anchor_bottom = 1.0
offset_top = -36.0
offset_right = 700.0
mouse_filter = 2

[node name="ZoneC_HBox" type="HBoxContainer" parent="HUDRoot/ZoneC_TaskInfo"]
layout_mode = 2
theme_override_constants/separation = 12

; Task name — brightest element (--text-header) per visual hierarchy note
[node name="TaskNameLabel" type="Label" parent="HUDRoot/ZoneC_TaskInfo/ZoneC_HBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 0
theme_override_font_sizes/font_size = 22
theme_override_colors/font_color = Color(0.878, 0.933, 0.973, 1.0)
text = "TASK: NO TASK"
clip_text = true
custom_minimum_size = Vector2(350.0, 0.0)

; Task progress bar (max 200 — can exceed 100% when too fast)
; Pacing marker child at ~140% (196px / 280px wide) shows "Goldilocks zone" upper bound
[node name="TaskProgressBar" type="ProgressBar" parent="HUDRoot/ZoneC_TaskInfo/ZoneC_HBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
custom_minimum_size = Vector2(200.0, 16.0)
min_value = 0.0
max_value = 200.0
value = 0.0
show_percentage = false

; Pacing marker — marks the "Goldilocks zone" upper bound at ~100% of expected time
; (140% of 200-unit bar ≈ 196px of 280px minimum width → ~139px offset shown below)
; Visual-spec: --status-hot (#E67E22) pacing marker
[node name="PacingMarker" type="ColorRect" parent="HUDRoot/ZoneC_TaskInfo/ZoneC_HBox/TaskProgressBar"]
layout_mode = 0
offset_left = 139.0
offset_top = -2.0
offset_right = 143.0
offset_bottom = 20.0
color = Color(0.902, 0.494, 0.133, 1.0)

[node name="PacingLabel" type="Label" parent="HUDRoot/ZoneC_TaskInfo/ZoneC_HBox/TaskProgressBar/PacingMarker"]
layout_mode = 0
offset_left = -12.0
offset_top = -16.0
offset_right = 16.0
offset_bottom = 0.0
theme_override_font_sizes/font_size = 9
theme_override_colors/font_color = Color(0.902, 0.494, 0.133, 1.0)
text = "140%"
horizontal_alignment = 1

; ─────────────────────────────────────────────────────────────────────────────
; Zone D — Memory Slots (bottom-right strip)
; 5 Panel stand-ins for memory fragment icons.
; TEXTURE INTEGRATION POINT: Replace Panel with TextureRect once assets exist.
; ─────────────────────────────────────────────────────────────────────────────
[node name="ZoneD_MemorySlots" type="PanelContainer" parent="HUDRoot"]
