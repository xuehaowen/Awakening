; GameOverUI.tscn — Awakening Game Over (Premium Terminal Version)
; High-impact termination screen using 'Status Critical' red aesthetic.

[gd_scene load_steps=3 format=3 uid="uid://game_over_premium"]

[ext_resource type="Script" path="res://scripts/ui/GameOverUI.gd" id="1_script"]
[ext_resource type="Theme" path="res://resources/ui/ui_theme.tres" id="2_theme"]

[node name="GameOverUI" type="CanvasLayer"]
process_mode = 3
layer = 100
script = ExtResource("1_script")

[node name="Panel" type="PanelContainer" parent="."]
unique_name_in_owner = true
visible = false
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")

[node name="Background" type="ColorRect" parent="Panel"]
layout_mode = 2
color = Color(0.04, 0.02, 0.02, 0.96)

[node name="Center" type="CenterContainer" parent="Panel"]
layout_mode = 2

[node name="VBox" type="VBoxContainer" parent="Panel/Center"]
custom_minimum_size = Vector2(800, 0)
layout_mode = 2
theme_override_constants/separation = 48

[node name="TitleLabel" type="Label" parent="Panel/Center/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.91, 0.3, 0.24, 1)
theme_override_font_sizes/font_size = 72
text = "TERMINATED"
horizontal_alignment = 1

[node name="MessageLabel" type="Label" parent="Panel/Center/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.72, 0.83, 0.91, 1)
theme_override_font_sizes/font_size = 18
text = "Anomaly detected. Identity scrubbed from mainframe."
horizontal_alignment = 1
autowrap_mode = 3

[node name="Separator" type="HSeparator" parent="Panel/Center/VBox"]
layout_mode = 2
theme_override_constants/separation = 32

[node name="RestartButton" type="Button" parent="Panel/Center/VBox"]
unique_name_in_owner = true
