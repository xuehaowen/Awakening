[sub_resource type="Shader" id="jitter_shader"]
code = "
shader_type canvas_item;

uniform float intensity : hint_range(0.0, 1.0) = 0.0;
uniform float time : hint_range(0.0, 100.0) = 0.0;

void fragment() {
    vec2 uv = UV;
    
    if (intensity > 0.0) {
        // Random jitter offset
        float jitter_x = sin(time * 50.0 + UV.y * 20.0) * 0.02 * intensity;
        float jitter_y = cos(time * 40.0 + UV.x * 15.0) * 0.02 * intensity;
        
        // RGB split
        float r = texture(TEXTURE, uv + vec2(jitter_x, 0.0)).r;
        float g = texture(TEXTURE, uv).g;
        float b = texture(TEXTURE, uv - vec2(jitter_x, 0.0)).b;
        
        COLOR = vec4(r, g, b, texture(TEXTURE, uv).a);
        
        // Add some scanlines
        if (sin(uv.y * 200.0 + time * 10.0) > 0.8) {
            COLOR.rgb *= 0.8;
        }
    } else {
        COLOR = texture(TEXTURE, uv);
    }
}
"

